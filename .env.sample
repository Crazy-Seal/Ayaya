# Embedding 配置
EMBEDDING_API_KEY=YOUR_API_KEY
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 长期记忆配置
#MEMORY_BASE_PATH=

# 情景记忆提取：请选择支持 JSON Schema 结构化输出的 OpenAI 兼容接口及模型
EPISODIC_EXTRACTION_MODEL=qwen3.8-flash
EPISODIC_EXTRACTION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EPISODIC_EXTRACTION_API_KEY=YOUR_API_KEY

# Mem0 语义记忆提取：请选择支持按约定输出 JSON 对象的 OpenAI 兼容接口及模型
MEM0_EXTRACTION_MODEL=qwen3.8-flash
MEM0_EXTRACTION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MEM0_EXTRACTION_API_KEY=YOUR_API_KEY

# 情景/语义提取模型的最大上下文，只用于本地保守估算
MEMORY_EXTRACTION_MAX_CONTEXT_TOKENS=128000

# Tavily 配置（如需启用网络搜索工具则开启）
TAVILY_API_KEY=YOUR_API_KEY

# Electron 默认自行生成临时 Token 并管理后端，以下配置仅供开发覆盖。
# AYAYA_MANAGE_BACKEND=false
# AYAYA_API_TOKEN=外部后端模式下显式提供的至少43字符临时Token
# AYAYA_PYTHON_EXECUTABLE=C:/path/to/ayaya/python.exe
# AYAYA_BACKEND_CWD=C:/path/to/Ayaya
# AYAYA_BACKEND_BASE_URL=http://127.0.0.1:8000
